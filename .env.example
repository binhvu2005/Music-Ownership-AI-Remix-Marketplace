# ==============================================================================
# STEMVERSE MONOREPO ENV TEMPLATE
# ==============================================================================

NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. DATABASE & CACHE CONNECTIONS (Docker services)
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection URL (used by Prisma ORM in NestJS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stemverse?schema=public"

# Redis Cache & BullMQ parameters
REDIS_HOST=localhost
REDIS_PORT=6379

# Meilisearch Engine
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=meilimasterkey

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVICE PORT & SECRETS
# ------------------------------------------------------------------------------
BACKEND_PORT=3001
JWT_SECRET=super_secret_jwt_key_for_stemverse_token_signing
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------------------------
# 3. FRONTEND PORT & AUTHENTICATION (NextAuth)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# NextAuth secrets for Frontend session management
NEXTAUTH_SECRET=generate_a_random_32_chars_secret_here
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. OAUTH APIS (Optional for setup, required for OAuth logins)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=google_client_id_here
GOOGLE_CLIENT_SECRET=google_client_secret_here

SPOTIFY_CLIENT_ID=spotify_client_id_here
SPOTIFY_CLIENT_SECRET=spotify_client_secret_here

DISCORD_CLIENT_ID=discord_client_id_here
DISCORD_CLIENT_SECRET=discord_client_secret_here

# ------------------------------------------------------------------------------
# 5. STORAGE & AI API CONFIGURATIONS
# ------------------------------------------------------------------------------
# Cloudflare R2 or AWS S3 credentials for audio storage
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your_r2_access_key
STORAGE_SECRET_ACCESS_KEY=your_r2_secret_key
STORAGE_BUCKET_NAME=stemverse-assets-dev

# FastAPI AI Engine endpoints
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. PAYMENT CHANNELS
# ------------------------------------------------------------------------------
STRIPE_API_KEY=sk_test_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_stripe_webhook_secret_here

MOMO_PARTNER_CODE=momo_partner_code_here
MOMO_ACCESS_KEY=momo_access_key_here
MOMO_SECRET_KEY=momo_secret_key_here

VNPAY_TMN_CODE=vnpay_tmn_code_here
VNPAY_HASH_SECRET=vnpay_hash_secret_here
